<%- include('../../share/superheader') -%> <%- include('../../component/mainnav') -%>

<div class="container" style="direction: ltr">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <div class="wg-box">
        <div class="wg-title h4">Login:</div>
        <div class="wg-inner">
          <div class="mb-3 mx-3 row">
            <li id="formErrors" class="h6 d-none text-danger"></li>
          </div>
          <div class="mb-3 row">
            <label for="mailUser" class="form-label"> User Name Or Mail : </label>
            <div class="">
              <input type="text" class="form-control dir-ltr" id="mailUser" />
            </div>
          </div>
          <div class="mb-3 row">
            <label for="password" class="form-label"> Password : </label>
            <div class="">
              <input type="password" class="form-control dir-ltr" id="password" placeholder="" />
            </div>
          </div>
          <button onclick="submitForm()" class="btn btn-primary mb-3" style="width: 100%">
            Login
          </button>
        </div>
        <div class="wg-footer">
          <div class="mb-3 mx-4" style="">
            <a href="/user/recovery/"> Forget Password </a>
            <br />
            <a href="/user/register/"> Register </a>
            <br />
            <!-- <a>  Login With mail </a> -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  function submitForm() {
    let mailUser = document.getElementById('mailUser').value;
    let password = document.getElementById('password').value;
    //TODO: validate  inputs here
    let obj = { mailUser, password };
    // sendJSON(obj, '/user/login', ok);
    fetch('/user/login', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        mailUser,
        password,
      }),
    })
      .then((res) => res.json())
      .then((data) => ok(data));
    function ok(res) {
      let resObj = res;
      if (!resObj.state) {
        let erElement = document.getElementById('formErrors');
        erElement.innerText = resObj.message;
        erElement.classList.remove('d-none');
      } else {
        window.location.href = '/'; //
      }
    }
  }
</script>
<%- include('../../share/superfooter') -%>
