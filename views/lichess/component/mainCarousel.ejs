<div
  id="carouselExampleCaptions"
  class="carousel slide border border-3 rounded-3 p-2"
  data-bs-ride="carousel"
>
  <div class="carousel-indicators">
    <button
      type="button"
      data-bs-target="#carouselExampleCaptions"
      data-bs-slide-to="0"
      class="active"
      aria-current="true"
      aria-label="Slide 1"
    ></button>
    <button
      type="button"
      data-bs-target="#carouselExampleCaptions"
      data-bs-slide-to="1"
      aria-label="Slide 2"
    ></button>
    <button
      type="button"
      data-bs-target="#carouselExampleCaptions"
      data-bs-slide-to="2"
      aria-label="Slide 3"
    ></button>
  </div>
  <div class="carousel-inner">
    <div class="carousel-item active">
      <img src="/public/img/carousel/c3.png" class="d-block w-100 rounded-3" alt="..." />
      <div class="carousel-caption d-none d-md-block" style="text-align: left">
        <h5 class="fs-2">Play With The AI</h5>
        <p class="text-light fs-4">
          "Every game, a smart coach: we highlight your blunders and fix them together.""
        </p>
      </div>
    </div>
    <div class="carousel-item">
      <img src="/public/img/carousel/c5.png" class="d-block w-100 rounded-3" alt="..." />
      <div class="carousel-caption d-none d-md-block" style="text-align: left">
        <h5 class="fs-2">Solve Puzzles</h5>
        <p class="text-light fs-4">
          “Chess puzzles tailored to your weaknesses — train smarter, improve faster.”
        </p>
      </div>
    </div>
    <div class="carousel-item">
      <img src="/public/img/carousel/c7.png" class="d-block w-100 rounded-3" alt="..." />
      <div class="carousel-caption d-none d-md-block" style="text-align: left">
        <h5 class="fs-2">Board Editor</h5>
        <p class="text-light fs-4">
          “Online Board Editor — a professional tool for creating, teaching, and analyzing chess
          positions.”
        </p>
      </div>
    </div>
  </div>
  <button
    class="carousel-control-prev"
    type="button"
    data-bs-target="#carouselExampleCaptions"
    data-bs-slide="prev"
  >
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button
    class="carousel-control-next"
    type="button"
    data-bs-target="#carouselExampleCaptions"
    data-bs-slide="next"
  >
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>
</div>
