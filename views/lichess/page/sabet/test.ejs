<%- include('../../share/superheader') -%> <%- include('../../component/mainnav') -%> <% let
template="lichess" %>
<title>Meet the Minds Behind MetaMind</title>

<style>
  body {
    margin: 0;
    font-family: sans-serif;
    background: linear-gradient(to bottom right, #f9f6ef, #e9ddc9);
    color: #333;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    width: 99%;
    margin: 0 auto;
  }
</style>

<style>
  .secTeam {
    display: grid;
    text-align: center;
    /* padding: 1vw 2rem; */
    width: 95%;
    margin: 0 auto;

    /* background-image: url('/public/img/bgTeam.webp'); */
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 12px;
    inset: 0;
  }
  @media (min-width: 768px) and (max-width: 1250px) {
    .secTeam {
      grid-template-columns: 50% 50%;
    }
    .teamHeader {
      grid-column: 1 / span 2; /* start Col Num / length */
    }
  }
  @media (min-width: 1250px) {
    .secTeam {
      grid-template-columns: 25% 25% 25% 25%;
    }
    .teamHeader {
      padding-top: 40px;
      padding-bottom: -10px;
      grid-column: 1 / span 4; /* start Col Num / length */
      height: auto;
    }
  }

  .team-section h1 {
    margin-top: 4rem;
    text-align: center;
    margin-bottom: 3rem;
  }
  .section-heading {
    font-weight: 800;
    background: linear-gradient(90deg, #ce4500, #ee0000); /* بنفش-آبی گرادیانت */
    -webkit-background-clip: text;
    text-align: center;
    padding-bottom: 0.5rem;
    display: inline-block;
    margin-bottom: 2rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    display: inline-block;
    /* color: #ab9687; */
    font-size: 2.5rem;
    /* background: linear-gradient(to bottom, #f4f4f4, #f0ece6); */
  }
  .card1 {
    background: linear-gradient(to bottom, #f4f4f4, #f0ece6);
    width: 90%;
    border-radius: 20px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    padding: 1.5rem;
    text-align: center;
    position: relative;
    font-family: 'Segoe UI', sans-serif;
    margin-bottom: 10px;
  }
  .chess-icon1 {
    font-size: 4.5rem;
    position: absolute;
    top: 1rem;
    right: 1rem;
    opacity: 0.2;
    position: static;
    margin: -20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4b2e10; /* قهوه‌ای تیره */
    font-weight: bold;
  }
  .avatar1 {
    width: 10rem;
    height: 10rem;
    object-fit: cover;
    border-radius: 50%;
    margin: 1rem auto;
    border: 3px solid #d8cfc1;
  }

  .name1 {
    font-size: 1.3rem;
    font-weight: bold;
    color: #3e3224;
    margin-top: 0.5rem;
  }

  .role1 {
    font-size: 1rem;
    color: #7e6a4d;
    margin-bottom: 1rem;
  }

  .tags1 {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag1 {
    background-color: #e5dbcd;
    color: #5a4a35;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
  }
</style>


<p style="margin-top: 30px"></p>
