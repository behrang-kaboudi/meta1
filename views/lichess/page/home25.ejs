<style></style>
<%- include('../share/superheader') -%> <%- include('../component/mainnav') -%>
<script src="/public/js/chess.js"></script>
<link rel="stylesheet" href="/public/components/bk-chessboard/css/bk-board.css" />
<script src="/public/components/bk-chessboard/js/bk-board-class.js"></script>
<!-- <script src="https://player.twitch.tv/js/embed/v1.js"></script> -->
<style>
  .mainDiv {
    display: grid;
    grid-template-columns: 50% 50%;
    margin: 10px 5px 10px 5px;
  }
  .btn1 {
    grid-column: 1 / span 1;
  }
  .btn2 {
    grid-column: 2 / span 1;
  }
  .btn3 {
    grid-column: 1 / span 1;
  }
  .btn4 {
    grid-column: 2 / span 1;
  }
  .liveBoard1 {
    grid-column: 1 / span 2;
  }
  .liveBoard2 {
    grid-column: 1 / span 2;
  }
  .carousel {
    grid-column: 1 / span 2;
  }
  .counter {
    grid-column: 1 / span 2;
  }
  .grid-item {
    border: 1px solid #ccc;
    /* اینجا هیچ height ندیم → ارتفاع اتوماتیک میشه */
  }
  @media (min-width: 1024px) {
    .mainDiv {
      display: grid;
      grid-template-columns: 12% 12% 52% 12% 12%;
      /* grid-template-rows: 20% 20% 54% 6%; */
      margin: 15px 55px 20px 55px;
      /* grid-template-rows: auto auto auto auto; یا چند auto  */
      align-items: start; /* نذاره بکشه */
    }

    .btn1 {
      grid-column: 1 / span 1;
      grid-row: 1 / span 1; /* Row Num */
    }
    .btn2 {
      grid-column: 2 / span 1;
      grid-row: 1 / span 1; /* Row Num */
    }
    .btn3 {
      grid-column: 1 / span 1;
      grid-row: 2 / span 1; /* Row Num */
    }
    .btn4 {
      grid-column: 2 / span 1;
      grid-row: 2 / span 1; /* Row Num */
    }
    .btn5 {
      grid-column: 4 / span 1;
      grid-row: 1 / span 1; /* Row Num */
    }
    .btn6 {
      grid-column: 5 / span 1;
      grid-row: 1 / span 1; /* Row Num */
    }
    .btn7 {
      grid-column: 4 / span 1;
      grid-row: 2 / span 1; /* Row Num */
    }
    .btn8 {
      grid-column: 5 / span 1;
      grid-row: 2 / span 1; /* Row Num */
    }
    .liveBoard1 {
      grid-column: 1 / span 2;
      grid-row: 3 / span 2; /* Row Num */
    }
    .liveBoard2 {
      grid-column: 4 / span 2;
      grid-row: 3 / span 2; /* Row Num */
    }
    .carousel {
      grid-column: 3 / span 1;
      grid-row: 1 / span 3; /* Row Num */
    }
    .counter {
      grid-column: 3 / span 1;
      grid-row: 4 / span 1; /* Row Num */
    }
  }
</style>
<div class="mainDiv">
  <div class="btn1 m-1">
    <div
      data-island="HomeBtn"
      data-props='{"labelText":"Play With a Friend","event":"playWithFriend"}'
    ></div>
  </div>
  <div class="btn2 m-1">
    <div data-island="HomeBtn" data-props='{"labelText":"Play With the AI"}'></div>
  </div>
  <div class="btn3 m-1">
    <div
      data-island="HomeBtn"
      data-props='{"labelText":"Solve a Puzzle","event":"solvePuzzle"}'
    ></div>
  </div>
  <div class="btn4 m-1">
    <div
      data-island="HomeBtn"
      data-props='{"labelText":"Analyze a Game","event":"analyzeGame"}'
    ></div>
  </div>
  <div class="btn5 m-1">
    <div
      data-island="HomeBtn"
      data-props='{"labelText":"Board Editor","event":"boardEditor"}'
    ></div>
  </div>
  <div class="btn6 m-1">
    <div data-island="HomeBtn" data-props='{"labelText":"Train Openings"}'></div>
  </div>
  <div class="btn7 m-1">
    <div
      data-island="HomeBtn"
      data-props='{"labelText":"Play Simultaneous","event":"simultaneous"}'
    ></div>
  </div>
  <div class="btn8 m-1">
    <div data-island="HomeBtn" data-props='{"labelText":"Train Endgame"}'></div>
  </div>
  <div class="liveBoard1 mx-2"><%- include('../component/puzzleOfDay') -%></div>
  <div class="liveBoard2 mx-2"><%- include('../component/topLiveGame') -%></div>

  <div class="carousel m-1 grid-item"><%- include('../component/mainCarousel') -%></div>
  <div class="counter mx-3 d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-end p-2 dir-ltr">
      <img
        class=""
        src="/public/lichess/img/RPawn1.png"
        style="width: 11px; height: 14px; margin-right: 5px"
      />
      <img
        class=""
        src="/public/lichess/img/RPawn1.png"
        style="width: 13px; height: 17px; margin-right: 5px"
      />
      <img class="" src="/public/lichess/img/RPawn1.png" style="width: 15px; height: 21px" />
    </div>
    <!-- <div class="d-flex justify-content-between " style="font-size: 13px;"> -->
    <a class="mt-3" href="" id="nb_connected_players" style="font-size: 15px">
      <%- user.trans('Players Online') %>
      <strong data-count="50269">...</strong>
    </a>
    <a class="mt-3" href="" id="nb_connected_players" style="font-size: 15px">
      <%- user.trans('Games In Play') %>
      <strong data-count="120841">...</strong>
    </a>
    <!-- </div> -->

    <div class="d-flex align-items-end p-2 dir-ltr">
      <img
        class=""
        src="/public/lichess/img/RPawn1.png"
        style="width: 15px; height: 21px; margin-right: 5px"
      />
      <img
        class=""
        src="/public/lichess/img/RPawn1.png"
        style="width: 13px; height: 17px; margin-right: 5px"
      />
      <img class="" src="/public/lichess/img/RPawn1.png" style="width: 11px; height: 14px" />
    </div>
  </div>
</div>

<% let template="lichess" %>
<script type="text/javascript">
  pageEvs.on('playWithFriend', () => {
    userObjectUt.toLogin();
    const myModalEl = document.getElementById('creatFrieandlyChalenge');
    const myModal = new bootstrap.Modal(myModalEl);
    myModal.show();
    // myModal.hide();
  });
  pageEvs.on('solvePuzzle', () => {
    window.location.href = '/puzzle/training';
  });
  pageEvs.on('analyzeGame', () => {
    window.location.href = '/tool/analysis';
  });
  pageEvs.on('boardEditor', () => {
    window.location.href = '/tool/editor';
  });
  pageEvs.on('simultaneous', () => {
    window.location.href = '/simull/main';
  });
</script>

